# Copy this file to .env and fill in real values. Never commit .env to version control.

# Generate with: openssl rand -base64 32
export JWT_SECRET=your-256-bit-base64-secret-here

export DB_URL=jdbc:postgresql://localhost:5432/tlim
export DB_USERNAME=tlim_user

# Use a strong random password in production — never use the dev default.
export DB_PASSWORD=your-strong-db-password-here
